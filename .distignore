# Dev-only files. Excluded from the release zip and the main branch.
# Patterns are rsync excludes; a leading / anchors to the plugin root.
/.git/
/.github/
/.gitignore
/.distignore
/node_modules/
/src/
/scripts/
/worker/
/docs/
/dist/
/vendor/
/CLAUDE.md
/README.md
/README.dist.md
/phpcs.xml.dist
/webpack.config.js
/package.json
/package-lock.json
*.zip
*.log
.DS_Store
/site/
/_site/
